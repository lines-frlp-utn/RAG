{
    "name": "Chainlit dev container",
    "dockerComposeFile": ["../compose.milvus.yml", "compose.extend.yml"],

    "service": "dev-chainlit-app",
    "runServices": ["dev-chainlit-app" 
    // ,"aim-server", "aim-ui", 
    // "etcd", "minio", "standalone", "attu"
    ],
    "workspaceFolder": "/workspace/",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.debugpy",
                "ms-python.python",
                "GitHub.copilot",
                "charliermarsh.ruff"
            ]
        }
    }
}