{
    "name": "Chainlit dev container",
    "dockerComposeFile": ["../compose.milvus.yml", "compose.extend.yml"],

    "service": "chainlit-app",
    "workspaceFolder": "/workspace/",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.debugpy",
                "ms-python.python",
                "GitHub.copilot",
                "charliermarsh.ruff"
            ]
        }
    },
    // Fixes a bug so vscode detects venv in current directory
    "postCreateCommand": "ln -s /.venv /workspace/chainlit_app/.venv"
}