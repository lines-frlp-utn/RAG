    "version": "0.2.0",
    "configurations": [
        {"name":"Python Debugger: Current File with Arguments","type":"debugpy","request":"launch","program":"${file}","console":"integratedTerminal","args":["${command:pickArgs}"]},
        {
            "name": "Chainlit",
            "type": "debugpy",
            "request": "launch",
            "module": "app.main",
            "cwd": "${workspaceFolder}/chainlit_app"
        },
        {
            "name": "CPU llm",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "llm_models.reyna_cpu.main:app",
                "--reload",
                "--port",
                "8007"
            ],
        }
    ]
}