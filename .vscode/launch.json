{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chainlit",
            "type": "debugpy",
            "request": "launch",
            "module": "chainlit",
            "python": "/.venv/bin/python",
            "cwd": "/workspace/chainlit_app/",
            "args": [
                "run", "--host", "0.0.0.0", "--port", "80", "app/main.py"
            ],
        },
        {
            "name": "milvus",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "/.venv/bin/python",
            "cwd": "/workspace/vectordbs/Milvus/",
            "args": [
                "--host", "0.0.0.0", "--port", "8090", "main:app"
            ],
        },
        {
            "name": "chroma",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "/.venv/bin/python",
            "cwd": "/workspace/vectordbs/Chroma/",
            "args": [
                "--host", "0.0.0.0", "--port", "8090", "main:app"
            ],
        },
    ],
    "compounds": [
    {
      "name": "chainlit + milvus",
      "configurations": ["Chainlit", "milvus"],
      "stopAll": true
    },
    {
      "name": "chainlit + chroma",
      "configurations": ["Chainlit", "chroma"],
      "stopAll": true,
    }
  ]
}